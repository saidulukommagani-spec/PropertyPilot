# Server-side Google Maps key with Routes API enabled.
# Restrict this key to the backend's server IP and only these APIs.
# Copy this file to .env for local development; .env is ignored by git.
GOOGLE_MAPS_API_KEY=replace-with-server-side-key

# Initial dispatch office used to calculate customer travel estimates.
# Replace this locality-level default with the exact office address/pin when confirmed.
PROPERTY_PILOT_OFFICE_ADDRESS=LB Nagar, Hyderabad, Telangana, India
PROPERTY_PILOT_TRAVEL_MODE=DRIVE
